generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// NextAuth.js Models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                   String                 @id @default(cuid())
  name                 String?
  email                String?                @unique
  emailVerified        DateTime?              @map("email_verified")
  image                String?
  feedToken            String?                @unique @default(cuid()) @map("feed_token")
  accounts             Account[]
  sessions             Session[]
  youtubeSubscriptions YoutubeSubscription[]
  podcastSubscriptions PodcastSubscription[]
  userVideoStyles      UserVideoStyle[]
  userEpisodeStyles    UserEpisodeStyle[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// Summary Style (Shared Enum)
// ============================================

enum SummaryStyle {
  DEFAULT
  QUICK_READ
}

// ============================================
// YouTube Models
// ============================================

model YoutubeChannel {
  id            Int                   @id @default(autoincrement())
  youtube_id    String                @unique
  title         String
  description   String?
  rss_url       String?
  last_updated  DateTime              @default(now())
  videos        YoutubeVideo[]
  subscriptions YoutubeSubscription[]

  @@map("youtube_channels")
}

model YoutubeVideo {
  id               Int              @id @default(autoincrement())
  youtube_video_id String           @unique
  channel_id       Int
  channel          YoutubeChannel   @relation(fields: [channel_id], references: [id])
  title            String
  transcript       String?          @db.Text
  published_at     DateTime
  summaries        VideoSummary[]
  userStyles       UserVideoStyle[]

  @@map("youtube_videos")
}

model VideoSummary {
  id        Int          @id @default(autoincrement())
  videoId   Int          @map("video_id")
  video     YoutubeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  style     SummaryStyle @default(DEFAULT)
  content   String       @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([videoId, style])
  @@map("video_summaries")
}

model UserVideoStyle {
  id      Int          @id @default(autoincrement())
  userId  String       @map("user_id")
  videoId Int          @map("video_id")
  style   SummaryStyle
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   YoutubeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@map("user_video_styles")
}

model YoutubeSubscription {
  id           Int            @id @default(autoincrement())
  userId       String         @map("user_id")
  channelId    Int            @map("channel_id")
  summaryStyle SummaryStyle   @default(DEFAULT) @map("summary_style")
  createdAt    DateTime       @default(now()) @map("created_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId, summaryStyle])
  @@map("youtube_subscriptions")
}

// ============================================
// Podcast Models
// ============================================

model PodcastChannel {
  id            Int                   @id @default(autoincrement())
  feed_url      String                @unique
  title         String?
  description   String?
  site_url      String?
  image_url     String?
  last_updated  DateTime              @default(now())
  episodes      PodcastEpisode[]
  subscriptions PodcastSubscription[]

  @@map("podcast_channels")
}

model PodcastEpisode {
  id           Int                @id @default(autoincrement())
  podcast_id   Int
  podcast      PodcastChannel     @relation(fields: [podcast_id], references: [id])
  guid         String
  title        String
  audio_url    String
  transcript   String?            @db.Text
  published_at DateTime
  summaries    EpisodeSummary[]
  userStyles   UserEpisodeStyle[]

  @@unique([podcast_id, guid])
  @@map("podcast_episodes")
}

model EpisodeSummary {
  id        Int            @id @default(autoincrement())
  episodeId Int            @map("episode_id")
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  style     SummaryStyle   @default(DEFAULT)
  content   String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([episodeId, style])
  @@map("episode_summaries")
}

model UserEpisodeStyle {
  id        Int            @id @default(autoincrement())
  userId    String         @map("user_id")
  episodeId Int            @map("episode_id")
  style     SummaryStyle
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId])
  @@map("user_episode_styles")
}

model PodcastSubscription {
  id           Int            @id @default(autoincrement())
  userId       String         @map("user_id")
  podcastId    Int            @map("podcast_id")
  summaryStyle SummaryStyle   @default(DEFAULT) @map("summary_style")
  createdAt    DateTime       @default(now()) @map("created_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast      PodcastChannel @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId, summaryStyle])
  @@map("podcast_subscriptions")
}

// ============================================
// Real-time Worker Queue
// ============================================

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum QueueType {
  YOUTUBE
  PODCAST
}

model ProcessingQueue {
  id           Int         @id @default(autoincrement())
  type         QueueType
  entityId     Int
  status       QueueStatus @default(PENDING)
  priority     Int         @default(0)
  errorMessage String?
  attempts     Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("processing_queue")
}
